from __future__ import annotations

import json
from typing import Any, Dict, Type

from oie.orchestration.run_manifest import update_stage_status
from oie.orchestration.stage_base import Stage


class StageRunner:
    def __init__(self, ctx: Any) -> None:
        self.ctx = ctx

    def initial_checkpoint(self, stage: Stage, status: str = "running") -> Dict[str, Any]:
        return {
            "run_id": self.ctx.run_id,
            "stage": stage.name,
            "status": status,
            "input_count": 0,
            "processed_count": 0,
            "output_count": 0,
            "rejected_count": 0,
            "last_processed_index": None,
            "last_processed_id": None,
            "errors": [],
        }

    def write_checkpoint(self, stage: Stage, checkpoint: Dict[str, Any]) -> None:
        paths = stage.artifact_paths()
        paths["stage_dir"].mkdir(parents=True, exist_ok=True)
        paths["checkpoint"].write_text(
            json.dumps(checkpoint, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )

    def write_metrics(self, stage: Stage, checkpoint: Dict[str, Any]) -> None:
        paths = stage.artifact_paths()
        metrics = {
            "run_id": checkpoint["run_id"],
            "stage": checkpoint["stage"],
            "status": checkpoint["status"],
            "input_count": checkpoint["input_count"],
            "processed_count": checkpoint["processed_count"],
            "output_count": checkpoint["output_count"],
            "rejected_count": checkpoint["rejected_count"],
            "error_count": len(checkpoint["errors"]),
        }
        paths["metrics"].write_text(
            json.dumps(metrics, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )

    def append_output(self, stage: Stage, item: Dict[str, Any]) -> None:
        paths = stage.artifact_paths()
        paths["stage_dir"].mkdir(parents=True, exist_ok=True)
        with paths["output"].open("a", encoding="utf-8") as output_file:
            output_file.write(json.dumps(item, ensure_ascii=False) + "\n")

    def read_output(self, stage: Stage) -> list[Dict[str, Any]]:
        paths = stage.artifact_paths()
        if not paths["output"].exists():
            return []
        return [
            json.loads(line)
            for line in paths["output"].read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]

    def read_checkpoint(self, stage: Stage) -> Dict[str, Any] | None:
        paths = stage.artifact_paths()
        if not paths["checkpoint"].exists():
            return None
        return json.loads(paths["checkpoint"].read_text(encoding="utf-8"))

    def run_stage(self, stage_cls: Type[Stage]) -> Dict[str, Any]:
        stage = stage_cls(self.ctx)
        stage.ensure_stage_dir()
        update_stage_status(self.ctx, stage.name, "running")
        checkpoint = self.initial_checkpoint(stage)
        previous_checkpoint = self.read_checkpoint(stage)
        if previous_checkpoint:
            checkpoint.update(previous_checkpoint)
            checkpoint["status"] = "running"
        inputs = list(stage.load_input())
        checkpoint["input_count"] = len(inputs)
        start_index = (
            int(checkpoint["last_processed_index"]) + 1
            if checkpoint.get("last_processed_index") is not None
            else 0
        )
        self.write_checkpoint(stage, checkpoint)

        try:
            for index, item in enumerate(inputs[start_index:], start=start_index):
                output_item = stage.process_item(item)
                self.append_output(stage, output_item)
                checkpoint["processed_count"] += 1
                checkpoint["output_count"] += 1
                checkpoint["last_processed_index"] = index
                checkpoint["last_processed_id"] = output_item.get("id")
                self.write_checkpoint(stage, checkpoint)
        except Exception as exc:
            checkpoint["status"] = "failed"
            checkpoint["errors"].append(
                {
                    "error_type": exc.__class__.__name__,
                    "error_message": str(exc),
                }
            )
            self.write_checkpoint(stage, checkpoint)
            self.write_metrics(stage, checkpoint)
            update_stage_status(self.ctx, stage.name, "failed")
            raise

        checkpoint["status"] = "completed"
        self.write_checkpoint(stage, checkpoint)
        self.write_metrics(stage, checkpoint)
        update_stage_status(self.ctx, stage.name, "completed")
        return checkpoint
